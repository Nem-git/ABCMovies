# ABCMovies self-hosted instance — Build 1 minimal config
# Values are placeholder names only. Real values supplied at runtime.
# Jellyfin URL is provided at runtime; it is not stored in this file (DEC-001).

# Core (gRPC only; no HTTP listener)
CORE_BIND_ADDRESS=127.0.0.1
CORE_GRPC_PORT=9876
ABCMOVIES_DB=data/abcmovies.db

# HTTP API frontend (JSON; sole HTTP session/cookie edge; dials core over gRPC)
API_BIND_ADDRESS=127.0.0.1
API_HTTP_PORT=8098
CORE_GRPC_ADDR=127.0.0.1:9876

# SSR web frontend (HTML; calls the HTTP API, not core)
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=8097
API_HTTP_ADDR=http://127.0.0.1:8098
