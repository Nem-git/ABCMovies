# Local test credential variable NAMES — copy to .env (gitignored) and fill in
# real values there. Never commit values. See docs/ENVIRONMENT.md §6 and
# docs/CI-CD.md §4.
#
ABCMOVIES_TEST_USERNAME=
ABCMOVIES_TEST_PASSWORD=

# Jellyfin provider slot (config: slots.jellyfin.accounts[].password-env).
JELLYFIN_PASSWORD=

# TMDB catalogue slot bearer token (config: slots.catalogue[].adapter "tmdb"
# reads the variable named by token-env).
TMDB_TOKEN=
