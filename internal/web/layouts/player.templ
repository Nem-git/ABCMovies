package layouts

templ Player(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
			<title>{ title } - ABCMovies</title>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body class="bg-black m-0 p-0 overflow-hidden select-none" style="background-color: #000;">
			{ children... }
			<script src="/static/js/shaka-player.compiled.js"></script>
			<script src="/static/js/player.js"></script>
			<script type="text/javascript" src="/static/js/alpine-csp.min.js" defer></script>
		</body>
	</html>
}
