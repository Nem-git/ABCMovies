package components

templ NavBar() {
	<nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-3 bg-gray-900/95 backdrop-blur border-b border-gray-700">
		<a href="/services" class="text-xl font-bold text-white hover:text-blue-400 transition">ABCMovies</a>
		<div class="flex items-center gap-4">
			@SearchBar()
		</div>
	</nav>
}
