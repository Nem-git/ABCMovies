package components

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"github.com/nem-git/abcmovies/internal/streamfmt"
)

templ StreamList(streams []oas.Stream, baseURL string) {
	if len(streams) > 0 {
		<div class="mt-8">
			<h2 class="text-xl font-semibold mb-4">Streams</h2>
			<div class="grid gap-2">
				for _, s := range streams {
					<a href={ baseURL + "/" + streamfmt.ShortName(s.EncodingFormat) + "/" + s.ID } class="flex items-center justify-between bg-gray-800 rounded-lg p-3 hover:bg-gray-700 transition">
						<span class="font-medium">{ s.Name }</span>
						<span class={ "text-xs font-medium px-2 py-1 rounded", streamfmt.BadgeColor(s.EncodingFormat) }>
							{ streamfmt.Label(s.EncodingFormat) }
						</span>
					</a>
				}
			</div>
		</div>
	}
}
