package components

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"strings"
)

templ MovieCard(tag string, movie oas.Movie) {
	@CardLink("/services/" + tag + "/movies/" + movie.ID) {
		<div class="group">
			<div class="aspect-[2/3] rounded-lg overflow-hidden bg-gray-700 mb-3">
				<img
					src={ movie.Poster.Value.String() }
					alt={ movie.Name + " Poster" }
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
					loading="lazy"
				/>
			</div>
			<h2 class="text-sm font-semibold truncate">{ movie.Name }</h2>
			if len(movie.Genres) > 0 {
				<p class="text-xs text-gray-400 mt-1 truncate">{ strings.Join(movie.Genres, ", ") }</p>
			}
		</div>
	}
}
