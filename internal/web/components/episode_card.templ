package components

import "github.com/nem-git/abcmovies/internal/oas"

templ EpisodeCard(tag string, seriesID string, seasonID string, episode oas.Episode) {
	@CardLink("/services/" + tag + "/series/" + seriesID + "/seasons/" + seasonID + "/episodes/" + episode.ID) {
		<div class="flex items-start gap-4">
			<div class="shrink-0 w-20 h-28 rounded-lg overflow-hidden bg-gray-700">
				<img src={ episode.Poster.Value.String() } alt={ episode.Name + " Thumbnail" } class="w-full h-full object-cover" loading="lazy"/>
			</div>
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2">
					if episode.EpisodeNumber.IsSet() {
						<span class="text-xs text-gray-500">Ep { episode.EpisodeNumber.Value }</span>
					}
					if episode.Duration != "" {
						<span class="text-xs text-gray-500">{ episode.Duration }</span>
					}
				</div>
				<h3 class="font-semibold mt-0.5">{ episode.Name }</h3>
				if episode.Description.IsSet() {
					<p class="text-sm text-gray-400 mt-1 line-clamp-2">{ episode.Description.Value }</p>
				}
			</div>
		</div>
	}
}
