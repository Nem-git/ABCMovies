package components

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"strconv"
)

templ SeriesCard(tag string, series oas.Series) {
	@CardLink("/services/" + tag + "/series/" + series.ID) {
		<div class="group">
			<div class="aspect-[2/3] rounded-lg overflow-hidden bg-gray-700 mb-3">
				<img
					src={ series.Poster.Value.String() }
					alt={ series.Name + " Poster" }
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
					loading="lazy"
				/>
			</div>
			<h2 class="text-sm font-semibold truncate">{ series.Name }</h2>
			if series.NumberOfSeasons > 0 {
				<p class="text-xs text-gray-400 mt-1">{ strconv.Itoa(series.NumberOfSeasons) } seasons</p>
			}
		</div>
	}
}
