package pages

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"github.com/nem-git/abcmovies/internal/web/components"
	"github.com/nem-git/abcmovies/internal/web/layouts"
)

templ ServicesList(services []*oas.Service) {
	@layouts.App("Services") {
		<div class="max-w-4xl mx-auto px-6 py-8">
			<h1 class="text-2xl font-bold mb-6">Streaming Services</h1>
			if len(services) == 0 {
				@components.EmptyState("No streaming services available right now.")
			} else {
				<div class="grid gap-4">
					for _, s := range services {
						@components.ServiceCard(s.Tag, *s)
					}
				</div>
			}
		</div>
	}
}
