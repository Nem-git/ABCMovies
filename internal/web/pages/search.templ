package pages

import (
	"github.com/nem-git/abcmovies/internal/search"
	"github.com/nem-git/abcmovies/internal/web/components"
	"github.com/nem-git/abcmovies/internal/web/layouts"
	"strings"
)

templ SearchResults(query string, results []search.Result, types []string) {
	@layouts.App("Search") {
		<div class="max-w-4xl mx-auto px-6 py-8">
			<input type="hidden" id="search-type-value" name="type" value={ strings.Join(types, ",") }/>
			@components.SearchTypeFilter(types)
			<div id="search-results">
				if query == "" {
					@components.EmptyState("Type something to search for movies and series.")
				} else if len(results) == 0 {
					<div>
						<h1 class="text-2xl font-bold mb-2">No results for "{ query }"</h1>
						<p class="text-gray-400">Try a different search term.</p>
					</div>
				} else {
					<h1 class="text-2xl font-bold mb-6">Results for "{ query }"</h1>
					<div class="grid gap-3">
						for _, r := range results {
							@components.SearchResultItemCard(r)
						}
					</div>
				}
			</div>
		</div>
	}
}
