package pages

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"github.com/nem-git/abcmovies/internal/web/components"
	"github.com/nem-git/abcmovies/internal/web/layouts"
)

templ SeasonDetail(tag string, seriesID string, season *oas.Season, episodes []oas.Episode, nextURL string) {
	@layouts.App(season.Name) {
		<div class="max-w-4xl mx-auto px-6 py-8">
			@components.BackLink("/services/"+tag+"/series/"+seriesID, seriesID)
			@components.BackdropHero(season.Backdrop.Value.String()) {
				<div>
					<h1 class="text-3xl font-bold text-white">{ season.Name }</h1>
					if season.Description.IsSet() {
						<p class="text-gray-300 mt-2 line-clamp-3">{ season.Description.Value }</p>
					}
					if season.NumberOfEpisodes.IsSet() {
						<p class="text-sm text-gray-400 mt-2">{ season.NumberOfEpisodes.Value } episodes</p>
					}
				</div>
			}
			if len(episodes) > 0 {
				<div class="mt-8">
					<h2 class="text-xl font-semibold mb-4">Episodes</h2>
					<div class="grid gap-3" id="episode-list">
						for _, ep := range episodes {
							@components.EpisodeCard(tag, seriesID, season.ID, ep)
						}
						@components.Sentinel(nextURL)
					</div>
				</div>
			} else {
				@components.EmptyState("No episodes available yet.")
			}
		</div>
	}
}
