package pages

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"github.com/nem-git/abcmovies/internal/web/components"
	"github.com/nem-git/abcmovies/internal/web/layouts"
	"strings"
)

templ MovieDetail(tag string, movie *oas.Movie, streams []oas.Stream, streamURL string) {
	@layouts.App(movie.Name) {
		<div class="max-w-4xl mx-auto px-6 py-8">
			@components.BackLink("/services/"+tag+"/movies", "Movies")
			@components.BackdropHero(movie.Backdrop.Value.String()) {
				<div class="flex items-end gap-6">
					<div class="shrink-0 w-24 md:w-32 rounded-lg overflow-hidden shadow-2xl hidden sm:block">
						<img src={ movie.Poster.Value.String() } alt={ movie.Name + " Poster" } class="w-full" loading="lazy"/>
					</div>
					<div class="min-w-0">
						<h1 class="text-3xl font-bold text-white">{ movie.Name }</h1>
						if movie.Description.IsSet() {
							<p class="text-gray-300 mt-2 line-clamp-3">{ movie.Description.Value }</p>
						}
						<div class="flex flex-wrap gap-2 mt-3">
							if len(movie.Genres) > 0 {
								for _, g := range movie.Genres {
									<span class="bg-white/10 backdrop-blur text-xs px-2 py-1 rounded">{ g }</span>
								}
							}
						</div>
						<div class="flex flex-wrap gap-3 mt-3 text-sm text-gray-400">
							if len(movie.Languages) > 0 {
								<span>{ strings.Join(movie.Languages, ", ") }</span>
							}
							if movie.Duration.IsSet() {
								<span>· { movie.Duration.Value }</span>
							}
						</div>
					</div>
				</div>
			}
			@components.StreamList(streams, streamURL)
		</div>
	}
}
