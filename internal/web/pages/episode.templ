package pages

import (
	"github.com/nem-git/abcmovies/internal/oas"
	"github.com/nem-git/abcmovies/internal/web/components"
	"github.com/nem-git/abcmovies/internal/web/layouts"
	"strings"
)

templ EpisodeDetail(tag string, seriesID string, seasonID string, episode *oas.Episode, streams []oas.Stream, streamURL string) {
	@layouts.App(episode.Name) {
		<div class="p-8 max-w-4xl mx-auto">
			@components.BackLink("/services/"+tag+"/series/"+seriesID+"/seasons/"+seasonID, "Season")
			<div class="mt-4">
				<h1 class="text-3xl font-bold">{ episode.Name }</h1>
				if episode.Description.IsSet() {
					<p class="text-gray-400 mt-2">{ episode.Description.Value }</p>
				}
				<div class="flex gap-4 mt-4 text-sm text-gray-500">
					if episode.Duration != "" {
						<span>{ episode.Duration }</span>
					}
					if len(episode.Languages) > 0 {
						<span>{ strings.Join(episode.Languages, ", ") }</span>
					}
					if episode.ContentRating.IsSet() {
						<span>{ episode.ContentRating.Value }</span>
					}
				</div>
			</div>
			@components.StreamList(streams, streamURL)
		</div>
	}
}
