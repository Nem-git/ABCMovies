{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "**/proto/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/docs/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/.tool-versions",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/Containerfile",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/Makefile",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/.github/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/renovate.json",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/config.example",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/.env.example",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/decisions/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/go.mod",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/go.sum",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/.gitignore",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/CONTRIBUTING.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/SECURITY.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/LICENSE",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/AGENTS.md",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/opencode.json",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "**/opencode.jsonc",
      "effect": "ask"
