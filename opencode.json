{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": {
      "*": "allow",
      "**/proto/**": "ask",
      "**/docs/**": "ask",
      "**/.tool-versions": "ask",
      "**/Containerfile": "ask",
      "**/Makefile": "ask",
      "**/.github/**": "ask",
      "**/renovate.json": "ask",
      "**/config.example": "ask",
      "**/.env.example": "ask",
      "**/AGENTS.md": "ask",
      "**/opencode.json": "ask"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "make run": "ask",
      "make run *": "ask",
      "make deps": "ask",
      "make deps *": "ask",
      "podman *": "ask",
      "docker *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git init": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git clone *": "ask",
      "git remote *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git branch *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git stash *": "ask",
      "git tag *": "ask",
      "git config *": "ask",
      "systemctl *": "ask",
      "service *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "yum *": "ask",
      "brew install *": "ask",
      "npm install *": "ask",
      "npm i *": "ask",
      "npm ci": "ask",
      "pnpm install *": "ask",
      "pnpm add *": "ask",
      "yarn install *": "ask",
      "yarn add *": "ask",
      "bun install *": "ask",
      "bun add *": "ask",
      "pip install *": "ask",
      "pip3 install *": "ask",
      "uv add *": "ask",
      "go get *": "ask",
      "go install *": "ask",
      "go mod tidy": "ask",
      "go mod vendor": "ask"
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
